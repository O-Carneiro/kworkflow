# Usage telemetry settings (see `kw telemetry --help`)
#
# Edit the numbers with `kw telemetry config`. `telemetry_consent`, `instance_id`
# and `consented_endpoint` are written by `kw telemetry opt-in` and `opt-out`;
# editing `endpoint` by hand makes kw ask for consent again.

telemetry_consent=ask
instance_id=
consented_endpoint=
endpoint=http://localhost:4318/v1/logs
upload_interval=86400
upload_backoff=3600
batch_size=500
